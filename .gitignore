.env
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Raw/generated data stays local. Keep only the marker files.
data/raw/*
!data/raw/.gitkeep
data/incoming/*
!data/incoming/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/quarantine/*
!data/quarantine/.gitkeep

reports/*.json
reports/*.csv
!reports/.gitkeep

# Local services
postgres_data/
logs/
airflow/logs/*
!airflow/logs/.gitkeep

# dbt build artifacts
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/docs_target/
dbt/.user.yml
