{
  "datasets": {
    "customers": {
      "file": "olist_customers_dataset.csv",
      "required_columns": ["customer_id", "customer_unique_id", "customer_zip_code_prefix", "customer_city", "customer_state"],
      "not_null": ["customer_id", "customer_unique_id"],
      "unique": [["customer_id"]]
    },
    "orders": {
      "file": "olist_orders_dataset.csv",
      "required_columns": ["order_id", "customer_id", "order_status", "order_purchase_timestamp", "order_approved_at", "order_delivered_carrier_date", "order_delivered_customer_date", "order_estimated_delivery_date"],
      "not_null": ["order_id", "customer_id", "order_status", "order_purchase_timestamp"],
      "unique": [["order_id"]],
      "accepted_values": {
        "order_status": ["approved", "canceled", "created", "delivered", "invoiced", "processing", "shipped", "unavailable"]
      }
    },
    "order_items": {
      "file": "olist_order_items_dataset.csv",
      "required_columns": ["order_id", "order_item_id", "product_id", "seller_id", "shipping_limit_date", "price", "freight_value"],
      "not_null": ["order_id", "order_item_id", "product_id", "seller_id", "price", "freight_value"],
      "unique": [["order_id", "order_item_id"]],
      "non_negative": ["price", "freight_value"]
    },
    "payments": {
      "file": "olist_order_payments_dataset.csv",
      "required_columns": ["order_id", "payment_sequential", "payment_type", "payment_installments", "payment_value"],
      "not_null": ["order_id", "payment_sequential", "payment_type", "payment_value"],
      "unique": [["order_id", "payment_sequential"]],
      "non_negative": ["payment_installments", "payment_value"]
    },
    "reviews": {
      "file": "olist_order_reviews_dataset.csv",
      "required_columns": ["review_id", "order_id", "review_score", "review_comment_title", "review_comment_message", "review_creation_date", "review_answer_timestamp"],
      "not_null": ["review_id", "order_id", "review_score"],
      "ranges": {"review_score": [1, 5]}
    },
    "products": {
      "file": "olist_products_dataset.csv",
      "required_columns": ["product_id", "product_category_name", "product_name_lenght", "product_description_lenght", "product_photos_qty", "product_weight_g", "product_length_cm", "product_height_cm", "product_width_cm"],
      "not_null": ["product_id"],
      "unique": [["product_id"]],
      "non_negative": ["product_name_lenght", "product_description_lenght", "product_photos_qty", "product_weight_g", "product_length_cm", "product_height_cm", "product_width_cm"]
    },
    "sellers": {
      "file": "olist_sellers_dataset.csv",
      "required_columns": ["seller_id", "seller_zip_code_prefix", "seller_city", "seller_state"],
      "not_null": ["seller_id"],
      "unique": [["seller_id"]]
    },
    "geolocation": {
      "file": "olist_geolocation_dataset.csv",
      "required_columns": ["geolocation_zip_code_prefix", "geolocation_lat", "geolocation_lng", "geolocation_city", "geolocation_state"],
      "not_null": ["geolocation_zip_code_prefix", "geolocation_lat", "geolocation_lng"],
      "ranges": {"geolocation_lat": [-90, 90], "geolocation_lng": [-180, 180]}
    },
    "category_translation": {
      "file": "product_category_name_translation.csv",
      "required_columns": ["product_category_name", "product_category_name_english"],
      "not_null": ["product_category_name", "product_category_name_english"],
      "unique": [["product_category_name"]]
    }
  },
  "foreign_keys": [
    {"name": "orders_customer_exists", "child_dataset": "orders", "child_column": "customer_id", "parent_dataset": "customers", "parent_column": "customer_id", "severity": "ERROR"},
    {"name": "order_items_order_exists", "child_dataset": "order_items", "child_column": "order_id", "parent_dataset": "orders", "parent_column": "order_id", "severity": "ERROR"},
    {"name": "order_items_product_exists", "child_dataset": "order_items", "child_column": "product_id", "parent_dataset": "products", "parent_column": "product_id", "severity": "ERROR"},
    {"name": "order_items_seller_exists", "child_dataset": "order_items", "child_column": "seller_id", "parent_dataset": "sellers", "parent_column": "seller_id", "severity": "ERROR"},
    {"name": "payments_order_exists", "child_dataset": "payments", "child_column": "order_id", "parent_dataset": "orders", "parent_column": "order_id", "severity": "ERROR"},
    {"name": "reviews_order_exists", "child_dataset": "reviews", "child_column": "order_id", "parent_dataset": "orders", "parent_column": "order_id", "severity": "WARN"}
  ]
}
